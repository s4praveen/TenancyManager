<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test-only relaxations: readable underscore names, xUnit naming, test-friendly patterns -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1860;CA1001;CA1062;CA2234;CA1852;CA1812;CA1861;CA1822</NoWarn>
  </PropertyGroup>
</Project>
