# Copy to .env.local and adjust. Values here are not secrets (SPA config is public).
# dev   = role picker, sends X-Dev-User / X-Dev-Roles (API must run with Auth:Mode=Dev)
# entra = Microsoft Entra ID sign-in via MSAL
VITE_AUTH_MODE=dev

# Empty = same origin (Vite proxies /api and /health to http://localhost:5080 in dev)
VITE_API_BASE_URL=

# Entra only (see scripts/entra/register-apps.ps1 output)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_API_SCOPE=
